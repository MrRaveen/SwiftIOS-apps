import SwiftUI

// The two kinds of feedback flash
enum FeedbackKind {
    case correct
    case wrong
}

struct CardView: View {
    let card: Card
    // nil when the card isn't flashing
    var flash: FeedbackKind? = nil
    // Runs when the card is tapped. The parent decides what happens.
    let onTap: () -> Void

    // Flash colour wins over the normal lit and unlit colours
    private var fillColor: Color {
        switch flash {
        case .correct: return .green
        case .wrong: return Constants.trapRed
        case nil: return card.isLit ? Constants.accentsBlue : Constants.trackGray
        }
    }

    var body: some View {
        Button(action: onTap) {
            RoundedRectangle(cornerRadius: 12)
                .fill(fillColor)
                .aspectRatio(1, contentMode: .fit)
                .scaleEffect(card.isLit ? 1.08 : 1)
                .animation(.easeInOut, value: card.isLit)
        }
        .buttonStyle(.plain)
    }
}

