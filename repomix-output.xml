import SwiftUI

struct HomeView: View {
    var body: some View {
        VStack(spacing: 32) {
            // The app title
            Text("Tap Frenzy")
                .font(.system(size: 34, weight: .bold))
                .foregroundColor(.black)

            // One big button per mode
            modeButton(.LightUp)
            modeButton(.trap)
        }
        .padding(24)
        .frame(maxWidth: 400)
        .frame(maxWidth: .infinity, maxHeight: .infinity)
        .background(Color.white.ignoresSafeArea())
        // Home has no navigation bar. The game screens show one with a Back button.
        .toolbar(.hidden, for: .navigationBar)
    }

    // A NavigationLink that pushes the game screen for one mode.
    // The label is the big blue button.
    private func modeButton(_ mode: GameMode) -> some View {
        NavigationLink {
            GameView(mode: mode)
            CardGridView(mode : mode)
        } label: {
            Text(mode.title)
                .font(.system(size: 24, weight: .semibold))
                .foregroundColor(.white)
                .frame(maxWidth: .infinity, minHeight: 120)
                .background(Constants.accentsBlue)
                .clipShape(RoundedRectangle(cornerRadius: 20))
        }
        .accessibilityIdentifier(mode == .classic ? "classicModeButton" : "trapModeButton")
    }
}

