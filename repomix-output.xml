import Foundation

enum Level: CaseIterable {
    case l1, l2, l3, l4

    // Label shown on screen
    var title: String {
        switch self {
        case .l1: return "L1"
        case .l2: return "L2"
        case .l3: return "L3"
        case .l4: return "L4"
        }
    }

    // How many cards the grid has at this level
    var gridCount: Int {
        switch self {
        case .l1: return 4
        case .l2: return 9
        case .l3: return 16
        case .l4: return 25
        }
    }

    // How long a lit card stays lit (seconds). Higher levels give less time.
    var litWindow: TimeInterval {
        switch self {
        case .l1: return 0.8
        case .l2: return 0.7
        case .l3: return 0.6
        case .l4: return 0.5
        }
    }

    // The level for the time that has passed in the round.
    // The 10 second round splits into four parts of 2.5 seconds each.
    static func forElapsed(_ elapsed: TimeInterval) -> Level {
        switch elapsed {
        case ..<2.5: return .l1
        case ..<5:   return .l2
        case ..<7.5: return .l3
        default:     return .l4
        }
    }
}
